#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define DEFAULT 0

/ {
    combos {
        compatible = "zmk,combos";

        BT0 {
            bindings = <&bt BT_SEL 0>;
            key-positions = <1 46>;
        };

        BT1 {
            bindings = <&bt BT_SEL 1>;
            key-positions = <2 46>;
        };

        BT2 {
            bindings = <&bt BT_SEL 2>;
            key-positions = <3 46>;
        };

        BT_Clear {
            bindings = <&bt BT_CLR_ALL>;
            key-positions = <0 46>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESC    &kp N1    &kp N2    &kp N3  &kp N4  &kp N5  &kp N6             &kp N7  &kp N8     &kp N9   &kp N0    &kp MINUS  &kp EQUAL  &kp BSPC
&kp TAB    &kp Q     &kp W     &kp E   &kp R   &kp T   &kp Y              &kp U   &kp I      &kp O    &kp P     &kp LBKT   &kp RBKT   &kp BSLH
&kp CAPS   &kp A     &kp S     &kp D   &kp F   &kp G   &kp H              &kp J   &kp K      &kp L    &kp SEMI  &kp SQT               &kp ENTER
&kp LSHFT  &kp Z     &kp X     &kp C   &kp V   &kp B   &kp N              &kp M   &kp COMMA  &kp DOT  &kp FSLH                        &kp RSHFT
&kp LCTRL  &kp LWIN  &kp LALT  &mo 1                           &kp SPACE                              &to 1     &to 0      &to 0      &kp DEL
            >;
        };

        num_arrows {
            bindings = <
&kp GRAVE       &kp F1      &kp F2    &kp F3         &kp F4  &kp F5  &kp F6             &kp F7  &kp F8      &kp F9      &kp F10   &kp F11  &kp F12  &kp BSPC
&kp TAB         &kp C_PREV  &kp UP    &kp C_NEXT     &trans  &trans  &trans             &trans  &trans      &trans      &trans    &trans   &trans   &trans
&kp KP_NUMLOCK  &kp LEFT    &kp DOWN  &kp RIGHT      &trans  &trans  &trans             &trans  &trans      &trans      &trans    &trans          &kp RET
&kp LSHFT       &trans      &trans    &kp C_AL_CALC  &trans  &trans  &trans             &trans  &kp C_PREV  &kp C_NEXT  &kp C_PP                    &kp RSHFT
&kp LCTRL       &kp LGUI    &trans    &to 0                                  &kp SPACE                                  &to 0     &trans   &trans   &kp DEL
            >;
        };
    };
};
